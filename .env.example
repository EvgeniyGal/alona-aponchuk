# Required for contact form email delivery (Lovable managed email)
LOVABLE_API_KEY=
# Optional override for Lovable send endpoint
# LOVABLE_SEND_URL=

# Site URL used for canonical, Open Graph, sitemap, and robots (no trailing slash)
# Production example:
NEXT_PUBLIC_SITE_URL=https://www.aponchukworkflow.com
# Vercel preview/prod custom domain if different:
# NEXT_PUBLIC_SITE_URL=https://alona-aponchuk.vercel.app
